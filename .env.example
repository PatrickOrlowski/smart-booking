# Skopiuj do .env i uzupełnij własnymi wartościami.

# --- Baza danych (Neon) ---
# Pooled (PgBouncer) — używane przez aplikację w runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct (bez poolera) — używane przez Prisma Migrate. Ten sam host bez sufiksu "-pooler".
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js ---
# Wygeneruj: npx auth secret
AUTH_SECRET=""
# Wymagane przy `next start` lokalnie i przy hostingu za własnym proxy.
# Na Vercelu zbędne — Auth.js wykrywa host automatycznie.
AUTH_TRUST_HOST="true"

# --- Aplikacja ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- E-maile (Resend) ---
# Bez klucza wysyłka jest pomijana, a treść ląduje w tabeli notifications (SKIPPED).
RESEND_API_KEY=""
MAIL_FROM="Planner <onboarding@resend.dev>"

# --- Cron (przypomnienia): Authorization: Bearer <CRON_SECRET> ---
CRON_SECRET=""

# --- Płatności (Stripe) ---
# Bez kluczy zadatki działają w trybie MANUAL (rozliczenie na miejscu).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- SMS (SMSAPI): bez tokenu wysyłka logowana jako SKIPPED ---
SMSAPI_TOKEN=""
SMS_FROM="Planner"

# --- Web Push: wygeneruj kluczami `npx web-push generate-vapid-keys` ---
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:kontakt@twojadomena.pl"
