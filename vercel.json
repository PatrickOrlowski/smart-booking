{
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/webhooks",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/reminders/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/webhooks/route.ts": {
      "maxDuration": 60
    }
  }
}
